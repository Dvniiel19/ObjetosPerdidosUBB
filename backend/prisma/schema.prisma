
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id_usuario           BigInt            @id @default(autoincrement())
  correo_institucional String            @unique @db.VarChar
  nombres              String            @db.VarChar
  apellidos            String            @db.VarChar
  /// usuario, encargado o administrador
  rol                  String            @default("usuario") @db.VarChar
  /// solo encargados
  id_punto             BigInt? 
  activo               Boolean           @default(true)
  creado_en            DateTime          @default(now()) @db.Timestamp(6)

  punto                PuntoAcopio?      @relation(fields: [id_punto], references: [id_punto], onDelete: Restrict, onUpdate: Cascade)
  objetosRegistrados   Objeto[]
  reportes             ReportePerdida[]
  reclamosAtendidos    Reclamo[]
  actasFirmadas        ActaDestruccion[]
  eventos              Bitacora[]

  @@index([id_punto])
  @@map("USUARIO")
}

model PuntoAcopio {
  id_punto   BigInt    @id @default(autoincrement())
  nombre     String    @db.VarChar
  ubicacion  String    @db.Text
  tipo       String    @db.VarChar
  publicado  Boolean   @default(false)
  habilitado Boolean   @default(true)

  encargados Usuario[]
  objetos    Objeto[]

  @@map("PUNTO_ACOPIO")
}

model Categoria {
  id_categoria Int              @id @default(autoincrement()) @db.SmallInt
  nombre       String           @unique @db.VarChar

  objetos      Objeto[]
  reportes     ReportePerdida[]

  @@map("CATEGORIA")
}

model Objeto {
  id_objeto         BigInt           @id @default(autoincrement())
  codigo            String           @unique @db.VarChar
  id_categoria      Int              @db.SmallInt
  id_punto          BigInt 
  registrado_por    BigInt 
  /// NULL salvo baja
  id_acta           BigInt? 
  descripcion       String           @db.Text
  hallado_en        DateTime         @db.Timestamp(6)
  lugar_hallazgo    String           @db.Text
  /// inicio del plazo de 1 anio
  registrado_en     DateTime         @default(now()) @db.Timestamp(6)
  /// en_custodia, no_reclamado, entregado, dado_de_baja
  estado            String           @default("en_custodia") @db.VarChar
  publicado         Boolean          @default(false)
  /// NULL hasta avisar
  alerta_enviada_en DateTime?        @db.Timestamp(6)

  punto             PuntoAcopio      @relation(fields: [id_punto], references: [id_punto], onDelete: Restrict, onUpdate: Cascade)
  categoria         Categoria        @relation(fields: [id_categoria], references: [id_categoria], onDelete: Restrict, onUpdate: Cascade)
  registrador       Usuario          @relation(fields: [registrado_por], references: [id_usuario], onDelete: Restrict, onUpdate: Cascade)
  fotografias       Fotografia[]
  reclamos          Reclamo[]
  acta              ActaDestruccion? @relation(fields: [id_acta], references: [id_acta], onDelete: Restrict, onUpdate: Cascade)

  @@index([id_punto])
  @@index([id_categoria])
  @@index([registrado_por])
  @@index([id_acta])
  @@map("OBJETO")
}

model Fotografia {
  id_objeto   BigInt 
  /// 1 a 3
  posicion    Int    @db.SmallInt
  archivo_url String @db.Text

  objeto      Objeto @relation(fields: [id_objeto], references: [id_objeto], onDelete: Restrict, onUpdate: Cascade)
  
  @@id([id_objeto, posicion])
  @@map("FOTOGRAFIA")
}

model ReportePerdida {
  id_reporte    BigInt     @id @default(autoincrement())
  id_usuario    BigInt 
  /// NULL si no se sabe
  id_categoria  Int?       @db.SmallInt
  descripcion   String     @db.Text
  perdido_en    DateTime   @db.Timestamp(6)
  lugar_perdida String     @db.Text
  /// abierto o cerrado
  estado        String     @default("abierto") @db.VarChar
  creado_en     DateTime   @default(now()) @db.Timestamp(6)

  categoria     Categoria? @relation(fields: [id_categoria], references: [id_categoria], onDelete: Restrict, onUpdate: Cascade)
  usuario       Usuario    @relation(fields: [id_usuario], references: [id_usuario], onDelete: Restrict, onUpdate: Cascade)
  
  @@index([id_categoria])
  @@index([id_usuario])
  @@map("REPORTE_PERDIDA")
}

model Reclamo {
  id_reclamo          BigInt    @id @default(autoincrement())
  /// NULL si no hubo coincidencia
  id_objeto           BigInt? 
  atendido_por        BigInt 
  rut_reclamante      String    @db.VarChar
  nombre_reclamante   String    @db.VarChar
  evidencia_identidad String    @db.Text
  evidencia_propiedad String    @db.Text
  /// en_revision, aprobado, rechazado, entregado
  estado              String    @default("en_revision") @db.VarChar
  motivo_decision     String?   @db.Text
  creado_en           DateTime  @default(now()) @db.Timestamp(6)
  /// NULL hasta entregar
  entregado_en        DateTime? @db.Timestamp(6)
  /// NULL hasta entregar
  numero_comprobante  String?   @unique @db.VarChar

  objeto              Objeto?   @relation(fields: [id_objeto], references: [id_objeto], onDelete: Restrict, onUpdate: Cascade)
  encargado           Usuario   @relation(fields: [atendido_por], references: [id_usuario], onDelete: Restrict, onUpdate: Cascade)
  
  @@index([id_objeto])
  @@index([atendido_por])
  @@map("RECLAMO")
}

model ActaDestruccion {
  id_acta      BigInt   @id @default(autoincrement())
  numero_acta  String   @unique @db.VarChar
  responsable  BigInt 
  ejecutada_en DateTime @db.Timestamp(6)
  archivo_url  String   @db.Text

  objetos      Objeto[]
  firmante     Usuario  @relation(fields: [responsable], references: [id_usuario], onDelete: Restrict, onUpdate: Cascade)
  
  @@index([responsable])
  @@map("ACTA_DESTRUCCION")
}

model Bitacora {
  id_evento     BigInt   @id @default(autoincrement())
  /// NULL si no se identifico
  id_usuario    BigInt? 
  accion        String   @db.VarChar
  recurso       String   @db.VarChar
  /// permitido, denegado o error
  resultado     String   @db.VarChar
  registrado_en DateTime @default(now()) @db.Timestamp(6)

  usuario       Usuario? @relation(fields: [id_usuario], references: [id_usuario], onDelete: Restrict, onUpdate: Cascade)
  
  @@index([id_usuario])
  @@map("BITACORA")
}